# Copy to .env and add your NVIDIA NIM provider key.
NVIDIA_API_KEY=
WORKBOOK_AGENT_MODEL_PROVIDER=nvidia
WORKBOOK_AGENT_MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b
WORKBOOK_AGENT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
WORKBOOK_AGENT_MODEL_TIMEOUT_SECONDS=60
WORKBOOK_AGENT_AGENT_MAX_ITERATIONS=8
WORKBOOK_AGENT_AGENT_RUN_TIMEOUT_SECONDS=360
WORKBOOK_AGENT_REQUIRE_WRITE_CONFIRMATION=true
